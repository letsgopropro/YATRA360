# Environment configuration for YATRA360 Backend

# Application Settings
PROJECT_NAME="YATRA360 API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
DEBUG=True

# Database Settings (PostgreSQL with SQLAlchemy)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yatra360_db"

# Security & Authentication (Placeholders for upcoming Auth module)
SECRET_KEY="yatra360-dev-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (Frontend origins allowed to make requests)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# External API Integrations (Placeholders for upcoming modules)
OPENWEATHER_API_KEY="mock-weather-key"
MAPBOX_ACCESS_TOKEN="mock-mapbox-token"
